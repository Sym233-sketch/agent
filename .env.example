# DeepSeek is fixed and always enabled. Configure its key in Render Environment or this ignored .env file.
MINCETONG_PORT=5173
# Cloud deployments require HTTPS. Team password protection is optional and off by default.
# MINCETONG_CLOUD=true
# MINCETONG_PUBLIC_ORIGIN=https://your-service.onrender.com
# MINCETONG_TEAM_PASSWORD=
# MINCETONG_TEAM_AUTH=true
DEEPSEEK_API_KEY=
# MINCETONG_DATA_DIR=
# Real connectors remain disabled unless explicitly implemented and authorized.
# MINCETONG_INGEST_TOKEN=
